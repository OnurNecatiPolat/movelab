MOVELAB_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://localhost,capacitor://localhost
VITE_API_BASE=http://127.0.0.1:8000
# Cloud examples:
# MOVELAB_CORS_ORIGINS=https://movelab.app,https://www.movelab.app,https://localhost,capacitor://localhost
# VITE_API_BASE=https://movelab-api.up.railway.app
# Recommended local/prod-style database
MOVELAB_DATABASE_URL=postgresql+psycopg://movelab:ChangeThisPassword@127.0.0.1:5432/movelab
# SQLite fallback for local experiments only
MOVELAB_DATA_DIR=backend/data
MOVELAB_DB=backend/data/movelab.sqlite
MOVELAB_DEPTH=12
MOVELAB_DEEP_DEPTH=16
MOVELAB_ENGINE_TIME=0.45
MOVELAB_DEEP_ENGINE_TIME=0.80
MOVELAB_MAX_PGN_BYTES=2097152
MOVELAB_BILLING_PROVIDER=manual
MOVELAB_BILLING_PORTAL_URL=
MOVELAB_BILLING_SUPPORT_EMAIL=billing@movelab.local
STOCKFISH_PATH=tools/stockfish/stockfish.exe
CHESSCOM_USER_AGENT=MoveLab/0.8 local-training-app contact: local-beta@example.com
